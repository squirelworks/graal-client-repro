function Hex(const S: string): string;
var
  I: Integer;
begin
  SetLength(Result, Length(S) div 2);
  for I := 1 to Length(Result) do
    Result[I] := Chr(StrToInt('$' + Copy(S, I * 2 - 1, 2)));
end;

function RealResource(const Name: string; out Data: string): Boolean;
begin
  Result := True;
  if SameText(Name, 'DVCLAL') then begin Data := Hex(R0); Exit; end;
  if SameText(Name, 'PACKAGEINFO') then begin Data := Hex(R1); Exit; end;
  if SameText(Name, 'TADVENTURE') then begin Data := Hex(R2); Exit; end;
