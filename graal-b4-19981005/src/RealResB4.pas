  if SameText(Name, 'TEDITSIGNS') then begin Data := Hex(R8); Exit; end;
  if SameText(Name, 'TLINKLIST') then begin Data := Hex(R9); Exit; end;
  if SameText(Name, 'TLINKOPTIONS') then begin Data := Hex(R10); Exit; end;
