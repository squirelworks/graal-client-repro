  if SameText(Name, 'TOPENURL') then begin Data := Hex(R16); Exit; end;
  if SameText(Name, 'TOPTIONS') then begin Data := Hex(R17); Exit; end;
  if SameText(Name, 'TPERSONACTION') then begin Data := Hex(R18); Exit; end;
