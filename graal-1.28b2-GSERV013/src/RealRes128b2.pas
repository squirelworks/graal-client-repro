function Hex(const S: string): string;
var
  I: Integer;
begin
  SetLength(Result, Length(S) div 2);
  for I := 1 to Length(Result) do
    Result[I] := Chr(StrToInt('$' + Copy(S, I * 2 - 1, 2)));
end;

function RealResource(const Name: string; out Data: string): Boolean;
begin
  { the player's own copy in assets/ wins (docs/assets.md) }
  if UserResource(Name, Data) then begin Result := True; Exit; end;
  Result := True;
  if SameText(Name, 'DVCLAL') then begin Data := Hex(R0); Exit; end;
  if SameText(Name, 'PACKAGEINFO') then begin Data := Hex(R1); Exit; end;
  if SameText(Name, 'TADVENTURE') then begin Data := Hex(R2); Exit; end;
  if SameText(Name, 'TCHESTEDIT') then begin Data := Hex(R3); Exit; end;
  if SameText(Name, 'TCONNECTFRAME') then begin Data := Hex(R4); Exit; end;
  if SameText(Name, 'TCONTROLSFRAME') then begin Data := Hex(R5); Exit; end;
  if SameText(Name, 'TDEBUGGERFRAME') then begin Data := Hex(R6); Exit; end;
  if SameText(Name, 'TEDITBADDY') then begin Data := Hex(R7); Exit; end;
  if SameText(Name, 'TEDITCHARACTER') then begin Data := Hex(R8); Exit; end;
  if SameText(Name, 'TEDITFLAGS') then begin Data := Hex(R9); Exit; end;
  if SameText(Name, 'TEDITPERSON') then begin Data := Hex(R10); Exit; end;
  if SameText(Name, 'TEDITSIGNS') then begin Data := Hex(R11); Exit; end;
  if SameText(Name, 'TLINKLIST') then begin Data := Hex(R12); Exit; end;
  if SameText(Name, 'TLINKOPTIONS') then begin Data := Hex(R13); Exit; end;
  if SameText(Name, 'TLOADLEVEL') then begin Data := Hex(R14); Exit; end;
  if SameText(Name, 'TMESSAGEEDITOR') then begin Data := Hex(R15); Exit; end;
  if SameText(Name, 'TMOREOPTIONS') then begin Data := Hex(R16); Exit; end;
  if SameText(Name, 'TOBJECTNAME') then begin Data := Hex(R17); Exit; end;
  if SameText(Name, 'TOPENURL') then begin Data := Hex(R18); Exit; end;
  if SameText(Name, 'TOPTIONS') then begin Data := Hex(R19); Exit; end;
  if SameText(Name, 'TPERSONACTION') then begin Data := Hex(R20); Exit; end;
  if SameText(Name, 'TPLAYERLIST') then begin Data := Hex(R21); Exit; end;
  if SameText(Name, 'TRECONNECTFRAME') then begin Data := Hex(R22); Exit; end;
  if SameText(Name, 'TSHOWCODES') then begin Data := Hex(R23); Exit; end;
  Data := '';
  Result := False;
end;

function RealResourceCount: Integer;
begin
  Result := Length(Names);
end;

function RealResourceName(I: Integer): string;
begin
  Result := Names[I];
end;

