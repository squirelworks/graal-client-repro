function UiTextWidth(const S: string; Face: TUiFace): Integer;
var
  I, C: Integer;
begin
  Result := 0;
  for I := 1 to Length(S) do
  begin
    C := Ord(S[I]);
    if (C < 32) or (C > 126) then C := Ord('?');
    case Face of
      ufBold: Inc(Result, BoldAdv[C]);
      ufLabel: Inc(Result, LabAdv[C]);
    else Inc(Result, RegAdv[C]);
    end;
  end;
end;

procedure UiDrawText(Dest: TGSurface; X, Y: Integer; const S: string; Color: Cardinal;
  Face: TUiFace);
var
  I, C, R, B, W, PX, PY: Integer;
  Bits: Cardinal;
begin
  for I := 1 to Length(S) do
  begin
    C := Ord(S[I]);
    if (C < 32) or (C > 126) then C := Ord('?');
    case Face of
      ufBold: W := BoldW[C];
      ufLabel: W := LabW[C];
    else W := RegW[C];
    end;
    for R := 0 to UiLineH - 1 do
    begin
      case Face of
        ufBold: Bits := BoldRows[C, R];
        ufLabel: Bits := LabRows[C, R];
      else Bits := RegRows[C, R];
      end;
      if Bits = 0 then Continue;
      PY := Y + R;
      if (PY < 0) or (PY >= Dest.Height) then Continue;
      for B := 0 to W - 1 do
        if Bits and (Cardinal(1) shl B) <> 0 then
        begin
          PX := X + B;
          if (PX >= 0) and (PX < Dest.Width) then Dest.Pixels[PX + PY * Dest.Width] := Color;
        end;
    end;
    case Face of
      ufBold: Inc(X, BoldAdv[C]);
      ufLabel: Inc(X, LabAdv[C]);
    else Inc(X, RegAdv[C]);
    end;
  end;
end;

