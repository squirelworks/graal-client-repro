function UiTextWidth(const S: string; Face: TUiFace): Integer;
var
  I, C: Integer;
begin
  Result := 0;
  for I := 1 to Length(S) do
  begin
    C := Ord(S[I]);
    if (C < 32) or (C > 126) then C := Ord('?');
    if Face = ufBold then Inc(Result, BoldAdv[C]) else Inc(Result, RegAdv[C]);
  end;
end;

procedure UiDrawText(Dest: TGSurface; X, Y: Integer; const S: string; Color: Cardinal;
  Face: TUiFace);
var
  I, C, R, B, W, PX, PY: Integer;
  Bits: Cardinal;
begin
  for I := 1 to Length(S) do
  begin
    C := Ord(S[I]);
    if (C < 32) or (C > 126) then C := Ord('?');
    if Face = ufBold then W := BoldW[C] else W := RegW[C];
    for R := 0 to UiLineH - 1 do
    begin
      if Face = ufBold then Bits := BoldRows[C, R] else Bits := RegRows[C, R];
      if Bits = 0 then Continue;
      PY := Y + R;
      if (PY < 0) or (PY >= Dest.Height) then Continue;
      for B := 0 to W - 1 do
        if Bits and (Cardinal(1) shl B) <> 0 then
        begin
          PX := X + B;
          if (PX >= 0) and (PX < Dest.Width) then Dest.Pixels[PX + PY * Dest.Width] := Color;
        end;
    end;
    if Face = ufBold then Inc(X, BoldAdv[C]) else Inc(X, RegAdv[C]);
  end;
end;

