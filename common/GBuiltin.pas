function Bytes(I: Integer): string;
  procedure Take(const B: array of Byte);
  begin
    SetLength(Result, Length(B));
    if Length(B) > 0 then Move(B[0], Result[1], Length(B));
  end;
begin
  Result := '';
  case I of
    0: Take(F0);
    1: Take(F1);
