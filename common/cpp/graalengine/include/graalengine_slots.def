/* The callback slots, one GE_SLOT per `graal_set<Name>` export.
 *
 *   GE_SLOT(Name, ReturnType, DefaultWhenEmpty, (params), (args), Builds)
 *
 * Builds is GRAAL_BUILD_* bits: which program fills the slot. 4208 is the
 * 4.x launcher's list (torque/4208-launcher.md, 94 names), 5007 the 5.0
 * launcher's (torque/5007-launcher.md, 95 names: eight added, seven
 * dropped), 3D the bridge the 3D library fills (torque/engine-4208.md, 19
 * names). Names are the original's; arguments are the rebuild's own.
 *
 * Keep the groups in this order; a launcher may list slots by index. */

#ifndef GE_B4
#define GE_B4 1
#define GE_B5 2
#define GE_B3D 4
#define GE_B45 3
#endif

/* ---- Screen, clip, 2D matrix ---------------------------------------- */
GE_SLOT(GetScreenWidth, int32_t, 0, (void), (), GE_B45)
GE_SLOT(GetScreenHeight, int32_t, 0, (void), (), GE_B45)
GE_SLOT(SetClippingRectangle, void, , (int32_t x, int32_t y, int32_t w, int32_t h), (x, y, w, h), GE_B45)
GE_SLOT(GetClippingRectangle, void, , (graal_rect *out), (out), GE_B45)
GE_SLOT(PushGraal2DMatrix, void, , (const graal_matrix2d *m), (m), GE_B45)
GE_SLOT(PopGraal2DMatrix, void, , (void), (), GE_B45)
GE_SLOT(IsGraal2DMatrixActivated, int32_t, 0, (void), (), GE_B45)
GE_SLOT(GetGraal2DMatrix, int32_t, 0, (graal_matrix2d *out), (out), GE_B45)
GE_SLOT(PushColorMatrix, void, , (const float *m20), (m20), GE_B5)
GE_SLOT(PopColorMatrix, void, , (void), (), GE_B5)

/* ---- Tiles ----------------------------------------------------------- */
GE_SLOT(CreateTilesBuffer, int32_t, 0, (int32_t w, int32_t h), (w, h), GE_B45)
GE_SLOT(DeleteTilesBuffer, void, , (int32_t buf), (buf), GE_B45)
GE_SLOT(SetTilesBufferSize, void, , (int32_t buf, int32_t w, int32_t h), (buf, w, h), GE_B45)
GE_SLOT(ScrollTilesBuffer, void, , (int32_t buf, int32_t dx, int32_t dy), (buf, dx, dy), GE_B45)
GE_SLOT(StartTilesDrawing, void, , (int32_t buf), (buf), GE_B45)
GE_SLOT(EndTilesDrawing, void, , (int32_t buf), (buf), GE_B45)
/* Six arguments, as the engine's 2D-tile helper passes. */
GE_SLOT(Draw2DTile, void, , (int32_t buf, const graal_texture *sheet, int32_t sx, int32_t sy, int32_t dx, int32_t dy),
        (buf, sheet, sx, sy, dx, dy), GE_B45)
GE_SLOT(Clear2DTile, void, , (int32_t buf, int32_t dx, int32_t dy), (buf, dx, dy), GE_B45)
GE_SLOT(Draw3DTile, void, , (int32_t buf, const graal_texture *sheet, int32_t sx, int32_t sy, int32_t dx, int32_t dy),
        (buf, sheet, sx, sy, dx, dy), GE_B45)
GE_SLOT(Clear3DTile, void, , (int32_t buf, int32_t dx, int32_t dy), (buf, dx, dy), GE_B45)
GE_SLOT(DrawTilesOnScreen, void, , (int32_t buf, int32_t x, int32_t y, int32_t sx, int32_t sy, int32_t w, int32_t h),
        (buf, x, y, sx, sy, w, h), GE_B45)

/* ---- Text ------------------------------------------------------------ */
GE_SLOT(DrawText, void, ,
        (int32_t x, int32_t y, const char *text, const char *font, int32_t size, int32_t style, uint32_t color),
        (x, y, text, font, size, style, color), GE_B45)
GE_SLOT(DrawShadowedText, void, ,
        (int32_t x, int32_t y, const char *text, const char *font, int32_t size, int32_t style, uint32_t color,
         uint32_t shadow),
        (x, y, text, font, size, style, color, shadow), GE_B45)
GE_SLOT(GetTextWidth, int32_t, 0, (const char *text, const char *font, int32_t size, int32_t style),
        (text, font, size, style), GE_B45)
GE_SLOT(GetTextHeight, int32_t, 0, (const char *font, int32_t size, int32_t style), (font, size, style), GE_B45)
GE_SLOT(GetTextAscent, int32_t, 0, (const char *font, int32_t size, int32_t style), (font, size, style), GE_B45)
GE_SLOT(GetTextDescent, int32_t, 0, (const char *font, int32_t size, int32_t style), (font, size, style), GE_B45)

/* ---- Pictures and shapes --------------------------------------------- */
GE_SLOT(DrawGraphics, void, ,
        (const graal_texture *tex, int32_t x, int32_t y, int32_t sx, int32_t sy, int32_t sw, int32_t sh,
         uint32_t modulate),
        (tex, x, y, sx, sy, sw, sh, modulate), GE_B45)
GE_SLOT(DrawGraphicsStretched, void, ,
        (const graal_texture *tex, int32_t x, int32_t y, int32_t w, int32_t h, int32_t sx, int32_t sy, int32_t sw,
         int32_t sh, uint32_t modulate),
        (tex, x, y, w, h, sx, sy, sw, sh, modulate), GE_B4)
GE_SLOT(FillScreenRectangle, void, , (int32_t x, int32_t y, int32_t w, int32_t h, uint32_t color), (x, y, w, h, color),
        GE_B45)
GE_SLOT(DrawLine, void, , (int32_t x0, int32_t y0, int32_t x1, int32_t y1, uint32_t color), (x0, y0, x1, y1, color),
        GE_B45)
GE_SLOT(DrawLine2, void, ,
        (float x0, float y0, float x1, float y1, float width, uint32_t color), (x0, y0, x1, y1, width, color), GE_B45)
GE_SLOT(DrawPolygonEx, void, ,
        (const graal_texture *tex, const float *xyuv, int32_t points, uint32_t color), (tex, xyuv, points, color),
        GE_B45)
GE_SLOT(GetTextureWidth, int32_t, 0, (const graal_texture *tex), (tex), GE_B45)
GE_SLOT(GetTextureHeight, int32_t, 0, (const graal_texture *tex), (tex), GE_B45)
GE_SLOT(GetTexturePixel, uint32_t, 0, (const graal_texture *tex, int32_t x, int32_t y), (tex, x, y), GE_B45)
GE_SLOT(IsPixelTransparent, int32_t, 0, (const graal_texture *tex, int32_t x, int32_t y), (tex, x, y), GE_B45)
GE_SLOT(IsRectangleTransparent, int32_t, 0, (const graal_texture *tex, int32_t x, int32_t y, int32_t w, int32_t h),
        (tex, x, y, w, h), GE_B45)
GE_SLOT(GetBitmapArrayRects, int32_t, 0, (const graal_texture *tex, graal_rect *out, int32_t max),
        (tex, out, max), GE_B45)
GE_SLOT(ForceTextureTransparency, void, , (const graal_texture *tex, int32_t on), (tex, on), GE_B5)
GE_SLOT(FreeGraalTexture, void, , (const graal_texture *tex), (tex), GE_B3D)

/* ---- Panels ---------------------------------------------------------- */
GE_SLOT(CreateDrawingPanel, int32_t, 0, (int32_t w, int32_t h), (w, h), GE_B45)
