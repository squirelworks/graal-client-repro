/* ---- External windows ------------------------------------------------ */
GE_SLOT(OpenExternalPlayerlist, void, , (void), (), GE_B45)
/* One player-list row (the lab's 5.12, 2026-11-13): the player's id, nick,
   head image, "account=..,level=..,communityname=..,attr[1]=.." and flags
   (0x4000 the client itself, 0x2000 a player on this server). Sent again
   whenever one of those changes; Delete takes the id. */
GE_SLOT(ExternalPlayerlistUpdate, void, , (int32_t id, const char *nick, const char *head, const char *props, int32_t flags), (id, nick, head, props, flags), GE_B45)
GE_SLOT(ExternalPlayerlistDelete, void, , (int32_t id), (id), GE_B45)
GE_SLOT(OpenExternalPM, void, , (const char *account, const char *text), (account, text), GE_B4)
GE_SLOT(OpenExternalHistory, void, , (const char *account), (account), GE_B4)
GE_SLOT(OpenExternalProfile, void, , (const char *account), (account), GE_B45)
GE_SLOT(OpenExternalOptions, void, , (void), (), GE_B45)
/* kind: 1 for the lab's 5.12 "You have been disconnected" warning. */
GE_SLOT(OpenMessageBox, void, , (const char *title, const char *text, int32_t kind), (title, text, kind), GE_B45)

