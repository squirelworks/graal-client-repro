GE_SLOT(DrawDrawingPanel, void, , (int32_t panel, int32_t x, int32_t y, uint32_t modulate), (panel, x, y, modulate), GE_B45)
GE_SLOT(DrawTriangleStripPanel, void, , (int32_t panel, const float *xyuv, int32_t points, uint32_t modulate),
        (panel, xyuv, points, modulate), GE_B45)
GE_SLOT(SaveDrawingPanel, int32_t, 0, (int32_t panel, const char *file), (panel, file), GE_B45)

