function Decode64(const Parts: array of string): string;
var
  I, J, V, Bits, N: Integer;
  C: Char;
  S: string;
begin
  N := 0;
  for I := 0 to High(Parts) do Inc(N, Length(Parts[I]));
  SetLength(Result, (N div 4) * 3);
  N := 0;
  V := 0;
  Bits := 0;
  for I := 0 to High(Parts) do
  begin
    S := Parts[I];
    for J := 1 to Length(S) do
    begin
      C := S[J];
      case C of
        'A'..'Z': V := (V shl 6) or (Ord(C) - Ord('A'));
        'a'..'z': V := (V shl 6) or (Ord(C) - Ord('a') + 26);
        '0'..'9': V := (V shl 6) or (Ord(C) - Ord('0') + 52);
        '+': V := (V shl 6) or 62;
        '/': V := (V shl 6) or 63;
      else
        Continue;
      end;
      Inc(Bits, 6);
      if Bits >= 8 then
      begin
        Dec(Bits, 8);
        Inc(N);
        Result[N] := Chr((V shr Bits) and $FF);
      end;
      V := V and ((1 shl Bits) - 1);
    end;
  end;
  SetLength(Result, N);
end;

function Lookup(const Key: string): Integer;
var
  I: Integer;
begin
  for I := 0 to High(Names) do
    if Names[I] = Key then
    begin
      Result := I;
      Exit;
    end;
  Result := -1;
end;

function Take(I: Integer): string;
begin
  case I of
    0: Result := Decode64(D0);
    1: Result := Decode64(D1);
    2: Result := Decode64(D2);
    3: Result := Decode64(D3);
    4: Result := Decode64(D4);
    5: Result := Decode64(D5);
    6: Result := Decode64(D6);
    7: Result := Decode64(D7);
    8: Result := Decode64(D8);
    9: Result := Decode64(D9);
    10: Result := Decode64(D10);
    11: Result := Decode64(D11);
    12: Result := Decode64(D12);
    13: Result := Decode64(D13);
    14: Result := Decode64(D14);
    15: Result := Decode64(D15);
    16: Result := Decode64(D16);
  else
    Result := '';
  end;
end;

function EmbeddedRes(const Name: string; out Data: string): Boolean;
var
  I: Integer;
begin
  { the player's own copy in assets/ wins (docs/assets.md) }
  if UserResource(Name, Data) then begin Result := True; Exit; end;
  Data := '';
  I := Lookup(UpperCase(Name));
  if I < 0 then I := Lookup(LowerCase(StringReplace(Name, '\', '/', [rfReplaceAll])));
  Result := I >= 0;
  if Result then Data := Take(I);
end;

function EmbeddedCount: Integer;
begin
  Result := 0;
end;

function EmbeddedName(I: Integer): string;
begin
  if (I >= 0) and (I < 0) then Result := Names[17 + I] else Result := '';
end;

function EmbeddedPath(const Rel: string): string;
var
  Key, F, D: string;
  S: TFileStream;
begin
  Result := '';
  Key := LowerCase(StringReplace(Rel, '\', '/', [rfReplaceAll]));
  if (Key = '') or (Pos('..', Key) > 0) or (Lookup(Key) < 17) then Exit;
  { a folder per set of files, so a newer build never reads an older one's }
  F := TempDir + 'graal-delphi-2.22-6ef84906' + DirSlash +
    StringReplace(Key, '/', DirSlash, [rfReplaceAll]);
  if FileExists(F) then
  begin
    Result := F;
    Exit;
  end;
  if not EmbeddedRes(Key, D) then Exit;
  try
    MakeDirs(ExtractFileDir(F));
    S := TFileStream.Create(F + '.part', fmCreate);
    try
      if D <> '' then S.WriteBuffer(D[1], Length(D));
    finally
      S.Free;
    end;
    if not RenameFile(F + '.part', F) then DeleteFile(F + '.part');
    if FileExists(F) then Result := F;
  except
    Result := '';
  end;
end;

end.
