function EmbeddedRes(const Name: string; out Data: string): Boolean;
var
  I: Integer;
begin
  Data := '';
  I := Lookup(UpperCase(Name));
  if I < 0 then I := Lookup(LowerCase(StringReplace(Name, '\', '/', [rfReplaceAll])));
  Result := I >= 0;
  if Result then Data := Take(I);
end;

function EmbeddedCount: Integer;
begin
  Result := 78;
end;

function EmbeddedName(I: Integer): string;
begin
  if (I >= 0) and (I < 78) then Result := Names[16 + I] else Result := '';
end;

function EmbeddedPath(const Rel: string): string;
var
  Key, F, D: string;
  S: TFileStream;
begin
  Result := '';
  Key := LowerCase(StringReplace(Rel, '\', '/', [rfReplaceAll]));
  if (Key = '') or (Pos('..', Key) > 0) or (Lookup(Key) < 16) then Exit;
  { a folder per set of files, so a newer build never reads an older one's }
  F := TempDir + 'graal-delphi-2.22-a816a5a8' + DirSlash +
    StringReplace(Key, '/', DirSlash, [rfReplaceAll]);
  if FileExists(F) then
  begin
    Result := F;
    Exit;
  end;
  if not EmbeddedRes(Key, D) then Exit;
  try
    MakeDirs(ExtractFileDir(F));
    S := TFileStream.Create(F + '.part', fmCreate);
    try
      if D <> '' then S.WriteBuffer(D[1], Length(D));
    finally
      S.Free;
    end;
    if not RenameFile(F + '.part', F) then DeleteFile(F + '.part');
    if FileExists(F) then Result := F;
  except
    Result := '';
  end;
end;

