function Decode64(const Parts: array of string): string;
var
  I, J, V, Bits, N: Integer;
  C: Char;
  S: string;
begin
  N := 0;
  for I := 0 to High(Parts) do Inc(N, Length(Parts[I]));
  SetLength(Result, (N div 4) * 3);
  N := 0;
  V := 0;
  Bits := 0;
  for I := 0 to High(Parts) do
  begin
    S := Parts[I];
    for J := 1 to Length(S) do
    begin
      C := S[J];
      case C of
        'A'..'Z': V := (V shl 6) or (Ord(C) - Ord('A'));
        'a'..'z': V := (V shl 6) or (Ord(C) - Ord('a') + 26);
        '0'..'9': V := (V shl 6) or (Ord(C) - Ord('0') + 52);
        '+': V := (V shl 6) or 62;
        '/': V := (V shl 6) or 63;
      else
        Continue;
      end;
      Inc(Bits, 6);
      if Bits >= 8 then
      begin
        Dec(Bits, 8);
        Inc(N);
        Result[N] := Chr((V shr Bits) and $FF);
      end;
      V := V and ((1 shl Bits) - 1);
    end;
  end;
  SetLength(Result, N);
end;

function Lookup(const Key: string): Integer;
var
  I: Integer;
begin
  for I := 0 to High(Names) do
    if Names[I] = Key then
    begin
      Result := I;
      Exit;
    end;
  Result := -1;
end;

