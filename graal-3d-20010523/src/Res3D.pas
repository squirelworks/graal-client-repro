function Bytes(const B: array of Byte): string;
begin
  SetLength(Result, Length(B));
  if Length(B) > 0 then Move(B[0], Result[1], Length(B));
end;

function ResFile(const Name: string; out Data: string): Boolean;
var
  I: Integer;
begin
  { the player's own copy in assets/ wins (docs/assets.md) }
  if UserResource(Name, Data) then begin Result := True; Exit; end;
  Data := '';
  Result := False;
  for I := 0 to High(Names) do
    if SameText(Names[I], Name) then
    begin
      case I of
        0: Data := Bytes(R0);
      end;
      Result := True;
      Exit;
    end;
end;

end.
